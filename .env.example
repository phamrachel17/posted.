# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Comma-separated. When set, only these emails can get a sign-in link.
ALLOWED_EMAILS=

# Optional. Your deployed URL, used in sign-in and invite links. Defaults to the request's host.
NEXT_PUBLIC_SITE_URL=

# Daily letter (optional). See README → Daily letter.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
LETTER_FROM=posted. <letters@your-domain.com>
CRON_SECRET=

# Whole songs on the record player (optional). Create an app at developer.spotify.com/dashboard,
# add the redirect URI <your site>/api/spotify/callback (and http://127.0.0.1:3000/api/spotify/callback
# for local development), and tick "Web Playback SDK" and "Web API".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
